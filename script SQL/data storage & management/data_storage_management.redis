-- SLOWLOG ĐỂ ĐO THỜI GIAN 
CONFIG SET slowlog-log-slower-than 0
SLOWLOG RESET

-- ĐO THỜI GIAN & DUNG LƯỢNG
EVAL "local cursor = '0' repeat local result = redis.call('SCAN', cursor, 'MATCH', 'dm:*', 'COUNT', 500) cursor = result[1] for _, key in ipairs(result[2]) do redis.call('DEL', key) end until cursor == '0' local genres = {'Action', 'Comedy', 'Drama', 'Sci-Fi', 'Animation', 'Horror', 'Adventure', 'Documentary'} local statuses = {'NOW_SHOWING', 'COMING_SOON', 'END_OF_SHOW'} for n = 1, 5000 do local id = tostring(n) local title = string.format('Movie %05d', n) local genre = genres[((n - 1) % 8) + 1] local year = 2000 + (n % 27) local rating = 5 + ((n * 7) % 51) / 10 local status = statuses[((n - 1) % 3) + 1] local description = 'Benchmark movie description number ' .. n .. ' for comparing MySQL and Redis storage and read performance.' redis.call('HSET', 'dm:movie:' .. id, 'movie_id', id, 'title', title, 'genre', genre, 'release_year', tostring(year), 'rating', string.format('%.1f', rating), 'movie_status', status, 'description', description) redis.call('SADD', 'dm:all_movies', id) end local movieCount = redis.call('SCARD', 'dm:all_movies') return {'Nap thanh cong ' .. movieCount .. ' phim vao Redis'}" 0


-- BẢNG KẾT QUẢ 
EVAL "local results = {} table.insert(results, '================================================================================') table.insert(results, '  DATA MANAGEMENT & STORAGE: KET QUA DO LUONG TREN REDIS') table.insert(results, '================================================================================') local movieCount = redis.call('SCARD', 'dm:all_movies') table.insert(results, '') table.insert(results, '--- PHAN 2: XAC MINH DATASET ---') table.insert(results, 'Tong so phim (dm:all_movies): ' .. movieCount) local logs = redis.call('SLOWLOG', 'GET', 10) local load_entry = nil for i = 1, #logs do local cmd = logs[i][4] if cmd and cmd[1] and string.upper(tostring(cmd[1])) == 'EVAL' and string.find(tostring(cmd[2] or ''), 'dm:movie:') then load_entry = logs[i] break end end table.insert(results, '') table.insert(results, '--- PHAN 1: THOI GIAN NAP (WRITE PERFORMANCE) ---') if load_entry then local load_us = tonumber(load_entry[3]) table.insert(results, string.format('Engine              : Redis 7 (In-Memory Hash)')) table.insert(results, string.format('Thoi gian nap (us)  : %d', load_us)) table.insert(results, string.format('Thoi gian nap (ms)  : %.3f', load_us / 1000.0)) else table.insert(results, 'Chua tim thay log nap du lieu. Hay chay Buoc 2 truoc!') end table.insert(results, '') table.insert(results, '--- PHAN 3: DUNG LUONG LUU TRU (STORAGE SIZE) ---') local info = redis.call('INFO', 'memory') local used_memory = string.match(info, 'used_memory:(%d+)') local used_kb = tonumber(used_memory) / 1024.0 local bytes_per_record = tonumber(used_memory) / movieCount local sample_bytes = redis.call('MEMORY', 'USAGE', 'dm:movie:2500') or 0 table.insert(results, string.format('used_memory (byte)       : %s', used_memory)) table.insert(results, string.format('used_memory (KB)         : %.2f', used_kb)) table.insert(results, string.format('Bytes/record (uoc luong) : %.2f', bytes_per_record)) table.insert(results, string.format('MEMORY USAGE dm:movie:2500: %d byte', sample_bytes)) table.insert(results, '') table.insert(results, '--- PHAN 4: TOC DO DOC (READ PERFORMANCE) ---') table.insert(results, '  4.1 Point Lookup: HGETALL dm:movie:2500') local movie2500 = redis.call('HGETALL', 'dm:movie:2500') local fields = '' for i = 1, #movie2500, 2 do fields = fields .. movie2500[i] .. '=' .. movie2500[i+1] if i + 2 <= #movie2500 then fields = fields .. ', ' end end table.insert(results, '      => ' .. fields) table.insert(results, '') table.insert(results, '  4.2 Point Lookup by Title: (khong co index title trong Redis)') table.insert(results, '      => Redis khong co secondary index kieu B+Tree nhu MySQL.') table.insert(results, '      => Can SCAN toan bo hoac dung RediSearch module.') table.insert(results, '') table.insert(results, '  4.3 Batch Read 100 phim dau (pipeline HGETALL):') local batch_count = 0 for n = 1, 100 do local data = redis.call('HGETALL', 'dm:movie:' .. n) if #data > 0 then batch_count = batch_count + 1 end end table.insert(results, '      => Doc thanh cong ' .. batch_count .. '/100 phim') table.insert(results, '') table.insert(results, '================================================================================') table.insert(results, '  LUU Y: Thoi gian doc (4.1-4.3) duoc do bang Slowlog cua Redis.') table.insert(results, '  Chay rieng tung lenh HGETALL va xem SLOWLOG GET de lay thoi gian.') table.insert(results, '================================================================================') return results" 0

-- Point Lookup
HGETALL dm:movie:2500

-- đọc 100 phim đầu
EVAL "local results = {} for n = 1, 100 do local data = redis.call('HGETALL', 'dm:movie:' .. n) table.insert(results, 'movie:' .. n .. ' title=' .. (data[4] or '?')) end return results" 0


-- Lấy thời gian thao tác
SLOWLOG GET 10

CONFIG SET slowlog-log-slower-than 10000
EVAL "local cursor = '0' local count = 0 repeat local result = redis.call('SCAN', cursor, 'MATCH', 'dm:*', 'COUNT', 500) cursor = result[1] for _, key in ipairs(result[2]) do redis.call('DEL', key) count = count + 1 end until cursor == '0' return 'Da xoa ' .. count .. ' key dm:*'" 0
