EVAL "local base = 1767254400 for r = 1, 10 do redis.call('DEL', 'benchmark:room:' .. r .. ':schedule') end for i = 0, 49999 do local room = i % 10 + 1 local movie = i % 20 + 1 local score = base + math.floor(i / 10) * 10800 redis.call('ZADD', 'benchmark:room:' .. room .. ':schedule', score, (i + 1) .. ':' .. movie) end return redis.call('ZCARD', 'benchmark:room:1:schedule')" 0

# Kiểm tra dữ liệu: 10 key, mỗi key 5000 phần tử
KEYS benchmark:room:*
ZCARD benchmark:room:1:schedule
ZRANGE benchmark:room:1:schedule 0 0 WITHSCORES
ZRANGE benchmark:room:1:schedule -1 -1 WITHSCORES

OBJECT ENCODING benchmark:room:1:schedule
CONFIG GET zset-max-listpack-entries

# Truy vấn mẫu
ZCOUNT benchmark:room:1:schedule 1772323200 
ZRANGEBYSCORE benchmark:room:1:schedule 1772323200 

# Đo thời gian thực thi 1 lần
CONFIG SET slowlog-log-slower-than 0
SLOWLOG RESET
ZRANGEBYSCORE benchmark:room:1:schedule 1772323200 


SLOWLOG GET 5
CONFIG SET slowlog-log-slower-than 10000

# Đo 500 lần 
ZCARD benchmark:room:1:schedule
CONFIG SET latency-tracking-info-percentiles "50 95 99"
CONFIG RESETSTAT
INFO commandstats
INFO latencystats

# Bộ nhớ dùng cho một phòng
MEMORY USAGE benchmark:room:1:schedule

