# Application
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USER=movie_user
DB_PASSWORD=movie_password
DB_NAME=movie_ticket_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_movie_booking_2026
JWT_EXPIRATION=7d

# Seat Hold TTL (in seconds, default 5 minutes = 300s)
SEAT_HOLD_TTL_SECONDS=300

# Stripe Test Mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3001

# Verification/reset email: development logs only; production requires Resend.
EMAIL_DELIVERY=console
EMAIL_API_KEY=
EMAIL_FROM=
